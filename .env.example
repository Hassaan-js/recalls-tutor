# Local development uses an embedded PostgreSQL database in .local/database.
# Production requires a managed PostgreSQL connection (use the pooled connection string); no local fallback.
DATABASE_URL=
# Vercel production builds apply migrations before building (scripts/vercel-build.mjs). Set to false to skip.
MIGRATE_ON_BUILD=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://127.0.0.1:3000
# Generate with scripts/setup-local-auth.mjs. Never use a sample secret in production (32+ characters).
BETTER_AUTH_SECRET=
# Development only: verification/reset messages saved in ignored .local/mail (no web mailbox).
AUTH_MAIL_MODE=file
# Production requires a verified sending domain and email delivery.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Optional: Google Analytics 4 measurement ID. Analytics load only after a visitor accepts the cookie banner.
NEXT_PUBLIC_GA_ID=
# Optional: Google Search Console HTML-tag verification code.
NEXT_PUBLIC_GSC_VERIFICATION=
# Google sign-in (AUTH-1). Optional: the button appears only when both are set.
# Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (BILL-1..8). Test keys start sk_test_; production refuses test keys unless STRIPE_ALLOW_TEST_MODE=true (staging).
STRIPE_SECRET_KEY=
STRIPE_ALLOW_TEST_MODE=
# Signing secret of the webhook endpoint /api/webhooks/stripe (whsec_...). Locally: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=

# Claude API for AI drafting, scanned-file reading, proposed fixes and the tutor on the server.
# Without it, development falls back to the local Claude app (CLAUDE_CLI_PATH, RECALLS_CLAUDE_MODEL).
ANTHROPIC_API_KEY=
CLAUDE_CLI_PATH=
RECALLS_CLAUDE_MODEL=

# Scheduled jobs (vercel.json): /api/cron/partners every 10 minutes, /api/cron/billing hourly, /api/cron/reconcile nightly.
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". Use a long random value (24+ characters).
CRON_SECRET=
